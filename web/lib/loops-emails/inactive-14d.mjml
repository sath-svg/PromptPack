<mjml>
  <mj-head>
    <mj-title>Anything we can fix?</mj-title>
    <mj-preview>You haven't been back. Tell us why, or pick up where you left off.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text color="#d4d4d8" font-size="16px" line-height="1.6" />
      <mj-body background-color="#0a0a0c" />
    </mj-attributes>
    <mj-style>
      a { color: #7BA7FF; }
      .pill {
        display: inline-block;
        padding: 4px 10px;
        border: 1px solid rgba(239,68,68,0.35);
        background-color: rgba(239,68,68,0.10);
        border-radius: 999px;
        color: #FCA5A5;
        font-family: 'SF Mono', Consolas, 'Liberation Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0a0a0c" width="600px">
    <mj-section padding="16px 24px 24px">
      <mj-column>
        <mj-table padding="0">
          <tr>
            <td width="48" style="padding:0 14px 0 0;vertical-align:middle;">
              <img src="https://image.skillset.so/img/icon-192.png" alt="Skillset" width="40" height="40" style="display:block;border-radius:10px;border:0;" />
            </td>
            <td style="font-size:18px;font-weight:600;color:#fafafa;letter-spacing:-0.01em;vertical-align:middle;">
              Skillset
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 8px">
      <mj-column>
        <mj-text font-size="30px" line-height="1.15" letter-spacing="-0.02em" color="#fafafa" font-weight="600" padding="0">
          Anything we can fix?
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 24px 16px">
      <mj-column>
        <mj-text padding="0 0 14px">
          You signed up two weeks ago and haven't been back. That's signal. Tells us we didn't hit the mark for you.
        </mj-text>
        <mj-text padding="0 0 14px">
          Two ways forward. Both take 30 seconds:
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px 16px">
      <mj-column width="50%">
        <mj-button background-color="#2563EB" color="#ffffff" border-radius="8px" font-weight="600" font-size="14px" padding="0" inner-padding="12px 18px" href="https://feedback.skillset.so">
          Tell us what's missing →
        </mj-button>
      </mj-column>
      <mj-column width="50%">
        <mj-button background-color="rgba(255,255,255,0.04)" color="#fafafa" border="1px solid rgba(255,255,255,0.12)" border-radius="8px" font-weight="600" font-size="14px" padding="0" inner-padding="12px 18px" href="https://skillset.so/skillset">
          Pick up where I left off
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 24px 32px">
      <mj-column>
        <mj-text font-size="13px" color="#a1a1aa" line-height="1.5" padding="0">
          No reply needed. We won't email you about inactivity again. But we'll send updates when features you'd care about ship.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column>
        <mj-divider border-color="rgba(255,255,255,0.06)" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section padding="20px 24px 32px">
      <mj-column>
        <mj-text font-family="'SF Mono', Consolas, 'Liberation Mono', monospace" font-size="11px" color="#71717a" line-height="1.6" letter-spacing="0.03em" padding="0">
          Skillset · save your prompts once, use them everywhere<br />
          <a href="https://skillset.so">skillset.so</a> · <a href="{unsubscribe_link}">unsubscribe</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
