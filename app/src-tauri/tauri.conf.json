{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Skillset",
  "version": "1.1.0",
  "identifier": "com.promptpack.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Skillset",
        "width": 1500,
        "height": 700,
        "minWidth": 900,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Turn your prompts into reusable skills",
    "longDescription": "Skillset is a desktop app to save your prompts as portable skills and run them across ChatGPT, Claude, Gemini, Midjourney, and any AI tool.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "frameworks": [],
      "entitlements": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["skillset", "promptpack"]
      }
    }
  }
}
